# Control's origin. Locally: the admin-API dev Control
# (`pnpm --filter @shutter/control dev:admin-api`) or a real Control.
CONTROL_BASE_URL=http://localhost:3200
# Control's ADMIN_API_TOKEN (the dev Control prints its default).
CONTROL_ADMIN_TOKEN=dev_admin_api_token_0123456789abcdefghijklmnop
# The operator login; also signs the session cookie. At least 32 characters.
ADMIN_BOOTSTRAP_TOKEN=dev_bootstrap_token_0123456789abcdefghijklmnop
# true behind a proxy that sets X-Forwarded-For (Railway); the login lockout keys on it.
ADMIN_TRUST_PROXY_HEADERS=false
