# Copy to .dev.vars for `wrangler dev` / `vite dev`. Wrangler loads this file
# automatically; it is gitignored. In production these are Worker secrets, and
# the R2 Rendition Store is a native binding declared in wrangler.jsonc.

# Dedicated credential for reading the complete configuration snapshot from
# Control. It must match Control's EDGE_CONFIG_TOKEN.
EDGE_CONFIG_TOKEN=

# Shared credential presented to the Railway origin. Must match Control's value.
ORIGIN_AUTH_TOKEN=

# Shutter Control, which fronts imgproxy and the Rendition Store.
ORIGIN_BASE_URL=https://control.example.test
