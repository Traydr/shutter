{
  "name": "@shutter/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc",
    "deploy:preview": "wrangler versions upload --config wrangler.deploy.jsonc",
    "dev": "vite dev",
    "generate-types": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "typecheck": "wrangler types --env-interface CloudflareBindings --check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@shutter/protocol": "workspace:*",
    "hono": "4.12.28"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "@cloudflare/vitest-pool-workers": "0.18.2",
    "@shutter/testkit": "workspace:*",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.4",
    "wrangler": "4.107.1"
  }
}
