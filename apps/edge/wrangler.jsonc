{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shutter-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "routes": [
    {
      "pattern": "shutter-edge.traydr.dev",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "RENDITION_STORE",
      "bucket_name": "shutter-renditions"
    }
  ],
  "secrets": {
    "required": ["CAPABILITY_KEYS", "ORIGIN_AUTH_TOKEN", "ORIGIN_BASE_URL"]
  }
}
