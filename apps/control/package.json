{
  "name": "@shutter/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node dist/src/migrate.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@shutter/protocol": "workspace:*",
    "@shutter/space-config": "workspace:*",
    "effect": "4.0.0-beta.103"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.18.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  }
}
