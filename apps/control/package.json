{
  "name": "@shutter/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node dist/migrate.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@hono/node-server": "2.0.8",
    "@shutter/protocol": "workspace:*",
    "@shutter/space-config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.28",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  }
}
