# Public, non-secret inputs for the Railway topology in .railway/railway.ts.
# Copy to .railway/deployment.env (Git ignores it), then:
#   set -a; source .railway/deployment.env; set +a; pnpm deployment:plan
# The Worker's name, R2 binding, and custom domain live in apps/edge/wrangler.jsonc;
# its MEDIA_STORE bucket must be the SHUTTER_R2_BUCKET below (Control's S3_BUCKET).
SHUTTER_PROJECT_NAME=my-shutter
SHUTTER_GITHUB_REPOSITORY=owner/shutter
SHUTTER_RAILWAY_REGION=us-west2
SHUTTER_CONTROL_DOMAIN=control.example.com
SHUTTER_EDGE_DOMAIN=media.example.com
SHUTTER_R2_BUCKET=my-shutter-media
SHUTTER_R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
SHUTTER_R2_REGION=auto
SHUTTER_CLOUDFLARE_ZONE_ID=zone-id
SHUTTER_IMGPROXY_ALLOWED_SOURCES=https://uploads.example.com/,https://ACCOUNT_ID.r2.cloudflarestorage.com/
# SHUTTER_SECRETS_SEEDED=true once the credential variables exist on Railway;
# from then on the plan preserve()s them instead of proposing their removal.
# SHUTTER_JOBS_VOLUME_NAME names the live Postgres volume after the first apply.
