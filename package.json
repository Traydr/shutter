{
  "name": "shutter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "build:packages": "pnpm -r --filter './packages/*' --sort --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy:edge": "pnpm --filter @shutter/edge run deploy",
    "format": "biome check --write .",
    "lint": "biome ci . && pnpm lint:edge-boundary && pnpm lint:phase2-config",
    "lint:edge-boundary": "node scripts/check-edge-boundary.mjs",
    "lint:phase2-config": "node scripts/check-phase2-config.mjs",
    "test": "node scripts/run-workspace-tests.mjs",
    "test:node": "pnpm build:packages && vitest run --config vitest.node.config.ts",
    "test:worker": "pnpm build:packages && pnpm --filter @shutter/edge test",
    "typecheck": "pnpm build:packages && pnpm -r --sort --if-present typecheck",
    "verify:v1": "node scripts/verify-v1.mjs --mode offline",
    "verify:v1:live": "node scripts/verify-v1.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@railway/cli": "5.26.0",
    "@types/node": "^22.18.0",
    "railway": "3.5.2",
    "typescript": "6.0.3",
    "vitest": "4.1.4",
    "wrangler": "4.107.1"
  }
}
