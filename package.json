{
  "name": "shutter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "build:packages": "pnpm -r --filter './assets' --filter './packages/*' --sort --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy:edge": "pnpm --filter @shutter/edge run deploy",
    "deployment:apply": "railway config apply",
    "deployment:plan": "railway config plan",
    "format": "biome check --write .",
    "lint": "biome ci . && oxlint . && pnpm lint:edge-boundary",
    "lint:edge-boundary": "node scripts/check-edge-boundary.mjs",
    "test": "node scripts/run-workspace-tests.mjs",
    "test:node": "pnpm build:packages && vitest run --config vitest.node.config.ts",
    "test:worker": "pnpm build:packages && pnpm --filter @shutter/edge test",
    "typecheck": "pnpm typecheck:deployment && pnpm build:packages && pnpm -r --sort --if-present typecheck",
    "typecheck:deployment": "tsc -p tsconfig.deployment.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@oxlint/plugins": "1.85.0",
    "@railway/cli": "5.62.1",
    "@types/node": "^22.20.4",
    "oxlint": "1.85.0",
    "railway": "3.11.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.140.0"
  }
}
