{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.nitro",
      "!!**/.output",
      "!!**/.tanstack",
      "!!**/.vite",
      "!!**/routeTree.gen.ts",
      "!!**/.wrangler",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/worker-configuration.d.ts",
      "!tools/oxlint/anti-slop",
      "!!assets/generated.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "noCommonJs": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
